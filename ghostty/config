font-family = Iosevka
font-style = Medium
font-style-bold = Medium
font-size = 18

#font-feature = -calt, +ss03, +ss08, +cv16, +cv30, +cv31 # Fira Code
font-feature = -calt, cv01 7, VSAB 7, VSAG 2, VSAH 3, VSAI 1, VSAO 3, VSAQ 2, VSAT 1

theme = Nvim Dark
background-opacity = 1.0

window-padding-balance = true
window-height = 24
window-width = 80
window-decoration = server
maximize = 0

adjust-cursor-thickness = 4
